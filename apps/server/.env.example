# App
PORT=3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# DB
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codejam
DB_USER=user
DB_PASSWORD=password

# JWT
JWT_ROOM_TOKEN_SECRET=secret
JWT_ROOM_TOKEN_EXPIRES_IN=24h

# Piston (Code Execution)
# Local (server runs on host machine):
# PISTON_API_URL=http://localhost:2000/api/v2
# Local Docker network (server and piston in same compose network):
# PISTON_API_URL=http://piston:2000/api/v2
# Staging/Production (private Piston VM):
# PISTON_API_URL=http://10.0.1.16:2000/api/v2
PISTON_API_URL=http://localhost:2000/api/v2
